{
  "name": "meshcall",
  "version": "0.2.1",
  "description": "Async typed RPC for TypeScript services: WebSocket direct or through the MeshCall Router",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4wefan/meshcall.git",
    "directory": "meshcall-ts"
  },
  "homepage": "https://github.com/t4wefan/meshcall#readme",
  "bugs": "https://github.com/t4wefan/meshcall/issues",
  "keywords": [
    "rpc",
    "websocket",
    "typed",
    "streaming",
    "router"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./web": {
      "types": "./dist/src/web.d.ts",
      "import": "./dist/src/web.js"
    },
    "./otel": {
      "types": "./dist/src/otel.d.ts",
      "import": "./dist/src/otel.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "meshcall": "./dist/src/launcher.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "yarn build",
    "test": "yarn build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "ajv": "^8",
    "ajv-formats": "^3",
    "ws": "^8.21.3",
    "zod": "^4"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
