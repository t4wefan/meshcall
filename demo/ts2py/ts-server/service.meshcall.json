{
  "protocol": "meshcall/1",
  "services": [
    {
      "name": "demo.v1.TypeScriptGreetingService",
      "version": "1",
      "source_module": "ts2py_service",
      "source_qualname": "TypeScriptGreetingService",
      "balance": {
        "kind": "round_robin",
        "key": null
      },
      "description": "A TypeScript service consumed by the generated Python client.",
      "targeted": false,
      "methods": [
        {
          "name": "count",
          "stream": "server_stream",
          "request": {
            "module": "ts2py_service",
            "qualname": "CountRequest",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "count"
              ],
              "additionalProperties": false
            }
          },
          "parameters": [
            "count"
          ],
          "response": null,
          "input_item": null,
          "output_item": {
            "module": "ts2py_service",
            "qualname": "NumberItem",
            "schema": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          },
          "balance": {
            "kind": "round_robin",
            "key": null
          },
          "description": "Stream the integers from 0 up to, but not including, count.",
          "annotations": {
            "idempotent": true,
            "read_only": true,
            "destructive": false
          },
          "deprecated": null
        },
        {
          "name": "sum",
          "stream": "client_stream",
          "request": {
            "module": "ts2py_service",
            "qualname": "SumRequest",
            "schema": {
              "type": "object",
              "properties": {
                "offset": {
                  "type": "integer",
                  "default": 0
                }
              },
              "additionalProperties": false
            }
          },
          "parameters": [
            "offset"
          ],
          "response": {
            "module": "ts2py_service",
            "qualname": "SumResult",
            "schema": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer"
                }
              },
              "required": [
                "total"
              ],
              "additionalProperties": false
            }
          },
          "input_item": {
            "module": "ts2py_service",
            "qualname": "NumberItem",
            "schema": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          },
          "output_item": null,
          "balance": {
            "kind": "round_robin",
            "key": null
          },
          "description": "Add every streamed value to offset and return the total.",
          "annotations": {
            "idempotent": true,
            "read_only": false,
            "destructive": false
          },
          "deprecated": null
        },
        {
          "name": "greet",
          "stream": "unary",
          "request": {
            "module": "ts2py_service",
            "qualname": "GreetingRequest",
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "repeat": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                }
              },
              "required": [
                "name",
                "repeat"
              ],
              "additionalProperties": false
            }
          },
          "parameters": [
            "name",
            "repeat"
          ],
          "response": {
            "module": "ts2py_service",
            "qualname": "GreetingResult",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "handled_by": {
                  "type": "string"
                }
              },
              "required": [
                "message",
                "handled_by"
              ],
              "additionalProperties": false
            }
          },
          "input_item": null,
          "output_item": null,
          "balance": {
            "kind": "round_robin",
            "key": null
          },
          "description": "Greet name repeat times and say which runtime answered.",
          "annotations": {
            "idempotent": true,
            "read_only": true,
            "destructive": false
          },
          "deprecated": null
        }
      ]
    }
  ]
}
